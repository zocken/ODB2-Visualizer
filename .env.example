# Verbindung zur PostgreSQL-Datenbank.
# Lokal (docker compose) wird sie automatisch gesetzt.
# Neon: Connection-String aus dem Neon-Dashboard, mit ?sslmode=require
DATABASE_URL=postgres://obd2:obd2-local@localhost:5432/obd2

# Port des Webservers (Render setzt PORT selbst)
PORT=8080

# Bei leerer Datenbank automatisch die Basiscodes importieren (Standard: true)
AUTO_SEED=true
