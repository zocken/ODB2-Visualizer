# Verbindung zur PostgreSQL-Datenbank.
# Lokal (docker compose) wird sie automatisch gesetzt.
# Neon: Connection-String aus dem Neon-Dashboard, mit ?sslmode=require
DATABASE_URL=postgres://obd2:obd2-local@localhost:5432/obd2

# Port des Webservers (Render setzt PORT selbst)
PORT=8080

# Bei leerer Datenbank automatisch die Basiscodes importieren (Standard: true)
AUTO_SEED=true

# Nächtlicher Abgleich der Pkw-Codes mit Wal33D/dtc-database (Standard: true)
AUTO_UPDATE=true
# Start des täglichen Laufs (Stunde, Fenster 3 Stunden) und Zeitzone
UPDATE_HOUR=3
UPDATE_TIMEZONE=Europe/Berlin

# KI-Chat (nur Backend; Werte gehören in die Laufzeitvariablen, nicht ins Repository)
# LM_GATEWAY_URL=https://…
# LM_GATEWAY_KEY=…
# Modellname wie in LM Studio; leer = Standard aus server/chat.js (DEFAULT_MODEL)
# LM_MODEL=qwen3.8-flash-next
# KI-Chat abschalten (KI-Richtlinie, Abschnitt 13): true sperrt den Chat, Seite und Sicherheitshinweise bleiben
# CHAT_DISABLED=false
