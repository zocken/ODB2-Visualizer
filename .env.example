# Verbindung zur PostgreSQL-Datenbank.
# Lokal (docker compose) wird sie automatisch gesetzt.
# Neon: Connection-String aus dem Neon-Dashboard, mit ?sslmode=require
DATABASE_URL=postgres://obd2:obd2-local@localhost:5432/obd2

# Port des Webservers (Render setzt PORT selbst)
PORT=8080

# Benutzerkonten: öffentliche Adresse ohne Unterpfad (Produktion zwingend HTTPS).
PUBLIC_APP_URL=http://localhost:8080
# Diese Adressen bekommen bei ihrer ersten E-Mail-Bestätigung die Administratorrolle.
# Kein Standardkonto, kein Standardpasswort. Mehrere Adressen mit Komma trennen.
AUTH_ADMIN_EMAILS=
# 2FA-Schlüssel: zufällige 32 Bytes in Base64, getrennt von der Datenbank sichern.
# Erzeugen: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# In Produktion erforderlich. Bestehenden Schlüssel bei Deployments beibehalten.
AUTH_ENCRYPTION_KEY=

# E-Mail-Versand für Registrierung und Passwort-Wiederherstellung.
# Port 465 nutzt direkt TLS, andere Ports erfordern STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Nur lokal mit einem SMTP-Testserver ohne TLS erlauben, nie in Produktion:
SMTP_ALLOW_INSECURE=false

# Bei leerer Datenbank automatisch die Basiscodes importieren (Standard: true)
AUTO_SEED=true

# Nächtlicher Abgleich der Pkw-Codes mit Wal33D/dtc-database (Standard: true)
AUTO_UPDATE=true
# Start des täglichen Laufs (Stunde, Fenster 3 Stunden) und Zeitzone
UPDATE_HOUR=3
UPDATE_TIMEZONE=Europe/Berlin

# KI-Chat (nur Backend; Werte gehören in die Laufzeitvariablen, nicht ins Repository)
# LM_GATEWAY_URL=https://…
# LM_GATEWAY_KEY=…
# Modellname wie in LM Studio; leer = Standard aus server/chat.js (DEFAULT_MODEL)
# LM_MODEL=qwen3.8-flash-next
# KI-Chat abschalten (KI-Richtlinie, Abschnitt 13): true sperrt den Chat, Seite und Sicherheitshinweise bleiben
# CHAT_DISABLED=false

# Interner MCP-Server fuer den KI-Chat (Docker Compose: http://mcp:8090/mcp)
# MCP_URL=http://localhost:8090/mcp

# Interne, selbst betriebene Websuche. In Docker Compose automatisch gesetzt.
# SEARXNG_URL=http://localhost:8081
